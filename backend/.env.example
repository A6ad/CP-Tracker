# PostgreSQL connection. Override via environment or a .env file.
DATABASE_URL=postgresql+psycopg://cp_tracker:cp_tracker@localhost:5432/cp_tracker

# JWT signing. CHANGE THIS IN PRODUCTION — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=*
